# --- Server Configuration ---
PORT=8080
DB_PATH=/app/data/health.db

# --- Ingest (required for data from n8n) ---
# Bearer token n8n sends to POST /api/ingest/health
INGEST_TOKEN=

# --- Claude insights (Optional) ---
# API key from https://platform.claude.com/; ANTHROPIC_MODEL defaults to claude-opus-5-5
ANTHROPIC_API_KEY=
