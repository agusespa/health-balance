# --- Server Configuration ---
PORT=8080
DB_PATH=/app/data/health.db

# --- Cloudflare Tunnel (docker-compose.yml) ---
# The app has no login: it is only reached through the tunnel and Cloudflare Access
TUNNEL_TOKEN=

# --- Claude insights (Optional) ---
# Preferred: a Claude Code container that serves POST /run. No API key needed.
# CLAUDE_NETWORK is the Docker network it is on (see `docker network ls`).
CLAUDE_NETWORK=
CLAUDE_RUN_URL=http://claude:8080/run
# Claude Code model alias: opus, sonnet or haiku
CLAUDE_RUN_MODEL=sonnet

# Fallback when CLAUDE_RUN_URL is empty: Messages API key from https://platform.claude.com/
# (ANTHROPIC_MODEL defaults to claude-sonnet-5-5)
ANTHROPIC_API_KEY=
