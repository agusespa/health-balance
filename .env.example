# --- Server Configuration ---
PORT=8080
DB_PATH=/app/data/health.db

# --- Ingest (required for data from n8n) ---
# Bearer token n8n sends to POST /api/ingest/health
INGEST_TOKEN=

# --- Claude insights (Optional) ---
# Preferred: the home-lab Claude Code container (same one n8n uses). No API key needed.
# CLAUDE_NETWORK is the Docker network it is on (see `docker network ls`).
CLAUDE_NETWORK=
CLAUDE_RUN_URL=http://claude:8080/run
# Claude Code model alias: opus, sonnet or haiku
CLAUDE_RUN_MODEL=opus

# Fallback when CLAUDE_RUN_URL is empty: Messages API key from https://platform.claude.com/
# (ANTHROPIC_MODEL defaults to claude-opus-5-5)
ANTHROPIC_API_KEY=
