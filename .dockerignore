# Version Control
.git
.gitignore

# Database & Data (Crucial to avoid "hot" DB corruption during build)
*.db
*.db-journal
*.db-wal
data/

# Documentation & Metadata
README.md
LICENSE
.github/

# Local Build Artifacts
app/
health-balance
*.exe
*.test
*.out

# OS Generated Files
.DS_Store
Thumbs.db

# Node and frontend build output (the image builds the frontend itself)
node_modules/
web/node_modules/
web/build/
web/.svelte-kit/
internal/ui/dist/*
!internal/ui/dist/.gitkeep
bin/
test-results/
playwright-report/
